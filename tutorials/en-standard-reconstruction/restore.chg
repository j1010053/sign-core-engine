                belongs EnglishInRelation
                phon:
                    /in/
        insert sign under node(language, @evo:en-standard:0) at end:
            sign john:
                belongs Noun
                belongs EnglishCaseBearer
                belongs Human
                belongs EnglishThirdSingular
                phon:
