        insert into node(language, @evo:en-standard:0) at end:
            trait EnglishThirdFemininePerson:
                belongs Human
        insert into node(language, @evo:en-standard:0) at end:
            trait EnglishThirdSingular:
                belongs AgreementBearer
                syn:
                    feature:
                        number = singular
                        person = third
        insert into node(language, @evo:en-standard:0) at end:
            trait EnglishVoiceBearer:
                syn:
                    feature:
                        voice = enum(active, passive)
        insert into node(language, @evo:en-standard:0) at end:
            trait StandardEnglishProfile:
                belongs GB020_Present
                belongs GB021_Present
                belongs GB028_Absent
                belongs GB030_Present
                belongs GB044_Present
                belongs GB057_Absent
                belongs GB059_Absent
                belongs GB068_Absent
                belongs GB070_Absent
                belongs GB074_Present
                belongs GB075_Absent
                belongs GB082_Absent
                belongs GB083_Present
                belongs GB084_Absent
                belongs GB086_Absent
                belongs GB103_Absent
                belongs GB107_Present
                belongs GB117_Present
                belongs GB118_Present
                belongs GB132_Present
                belongs GB147_Absent
                belongs GB155_Absent
                belongs GB262_Absent
                belongs GB322_Absent
                belongs GB522_Absent
        insert sign under node(language, @evo:en-standard:0) at end:
            sign EnglishAttributiveNP:
                belongs EnglishConstruction
                belongs AttributionConstruction
                belongs EnglishReferenceFrame
                syn:
                    feature:
                        order = enum(attribute_nominal)
                        order = attribute_nominal
                phon:
                    /{attribute} {nominal}/
        insert sign under node(language, @evo:en-standard:0) at end:
            sign EnglishCopularPredication:
                belongs EnglishConstruction
                belongs CopularPredicationConstruction
                belongs EnglishCopularFrame
                belongs AgreementBearer
                syn:
                    feature:
                        finite_form = enum(base, third_singular)
                        number => $slot.subject.syn.number @stage word
                        person => $slot.subject.syn.person @stage word
                        finite_form => third_singular / $slot.subject == [EnglishThirdSingular] @stage word
                            else finite_form => base
                phon:
                    realization:
                        case:
                            $self.syn.finite_form == third_singular:
                                /{subject} is {predicate}/
                            else:
                                /{subject} {copula} {predicate}/
                    /{subject} {copula} {predicate}/
                prag:
                    clause-type = declarative
        insert sign under node(language, @evo:en-standard:0) at end:
            sign EnglishCountNounForm:
                belongs EnglishConstruction
                belongs EnglishCountMeaning
                belongs EnglishCountNounFrame
                belongs AgreementBearer
                syn:
                    slots:
                        stem [Noun]
                phon:
                    realization:
                        case:
                            $self.syn.number == plural:
                                /{stem}s/
                            else:
                                /{stem}/
                    /{stem}/
                sem:
                    feature:
                        number => $self.syn.number @stage word
                    roles:
                        referent [Entity]
                        referent = {stem}
        insert sign under node(language, @evo:en-standard:0) at end:
            sign EnglishDefiniteNP:
                belongs EnglishConstruction
                belongs DeterminationConstruction
                belongs EnglishReferenceFrame
                syn:
                    feature:
                        determination = enum(definite, indefinite)
                        determination = definite
                phon:
                    /{determiner} {nominal}/
                prag:
                    identifiability = identifiable
        insert sign under node(language, @evo:en-standard:0) at end:
            sign EnglishDoNegation:
                belongs EnglishConstruction
                belongs NegationConstruction
                belongs EnglishNegationFrame
                belongs AgreementBearer
                syn:
                    slots:
                        subject [Nominal]
                        auxiliary [EnglishAuxiliary]
                        negator [EnglishNegator]
                    feature:
                        finite_form = enum(base, third_singular)
                        number => $slot.subject.syn.number @stage word
                        person => $slot.subject.syn.person @stage word
                        finite_form => third_singular / $slot.subject == [EnglishThirdSingular] @stage word
                            else finite_form => base
                phon:
                    realization:
                        case:
                            $self.syn.finite_form == third_singular:
                                /{subject} does {negator} {predicate}/
                            else:
                                /{subject} {auxiliary} {negator} {predicate}/
                    /{subject} {auxiliary} {negator} {predicate}/
                prag:
                    clause-type = declarative
        insert sign under node(language, @evo:en-standard:0) at end:
            sign EnglishIndefiniteNP:
                belongs EnglishConstruction
                belongs DeterminationConstruction
                belongs EnglishReferenceFrame
                syn:
                    feature:
                        determination = enum(definite, indefinite)
                        determination = indefinite
                phon:
                    /{determiner} {nominal}/
                prag:
                    identifiability = non-identifiable
        insert sign under node(language, @evo:en-standard:0) at end:
            sign EnglishIntransitiveClause:
                belongs EnglishConstruction
                belongs IntransitiveClauseConstruction
                belongs EnglishClauseFrame
                belongs AgreementBearer
                syn:
                    slot_features:
                        subject.case = $slot.predicate.syn.subject_case
                    feature:
                        finite_form = enum(base, third_singular)
                        agreement_number = enum(singular, plural)
                        subject_case = enum(nominative, accusative)
                        number => $slot.subject.syn.number @stage word
                        person => $slot.subject.syn.person @stage word
                        agreement_number => $slot.subject.syn.number @stage word
                        subject_case => require($slot.subject.syn.case, $slot.predicate.syn.subject_case) @stage word
                        finite_form => third_singular / $slot.subject == [EnglishThirdSingular] @stage word
                            else finite_form => base
                phon:
                    realization:
                        case:
                            $self.syn.finite_form == third_singular:
                                /{subject} {predicate}s/
                            else:
                                /{subject} {predicate}/
                    /{subject} {predicate}/
                prag:
                    clause-type = declarative
        insert sign under node(language, @evo:en-standard:0) at end:
            sign EnglishPeriphrasticPassive:
                belongs EnglishConstruction
                belongs PassiveConstruction
                belongs EnglishPassiveFrame
                belongs AgreementBearer
                syn:
                    feature:
                        finite_form = enum(base, third_singular)
                        number => $slot.patient.syn.number @stage word
                        person => $slot.patient.syn.person @stage word
                        finite_form => third_singular / $slot.patient == [EnglishThirdSingular] @stage word
                            else finite_form => base
                phon:
                    realization:
                        case:
                            $self.syn.finite_form == third_singular:
                                /{patient} is {predicate} by {agent}/
                            else:
                                /{patient} {auxiliary} {predicate} by {agent}/
                    /{patient} {auxiliary} {predicate} by {agent}/
                prag:
                    perspective = patient-prominent
        insert sign under node(language, @evo:en-standard:0) at end:
            sign EnglishPluralNP:
                belongs EnglishConstruction
                belongs NumberMarkingConstruction
                belongs EnglishCountMeaning
                belongs EnglishReferenceFrame
                belongs AgreementBearer
                syn:
                    feature:
                        number = plural
                phon:
                    /{nominal}{marker}/
                sem:
                    feature:
                        number = plural
        insert sign under node(language, @evo:en-standard:0) at end:
            sign EnglishPolarQuestion:
                belongs EnglishConstruction
                belongs PolarQuestionConstruction
                belongs EnglishQuestionFrame
                belongs AgreementBearer
                syn:
                    slots:
                        auxiliary [EnglishAuxiliary]
                        subject [Nominal]
                    feature:
                        finite_form = enum(base, third_singular)
                        number => $slot.subject.syn.number @stage word
                        person => $slot.subject.syn.person @stage word
                        finite_form => third_singular / $slot.subject == [EnglishThirdSingular] @stage word
                            else finite_form => base
                phon:
                    realization:
                        case:
                            $self.syn.finite_form == third_singular:
                                /does {subject} {clause}/
                            else:
                                /{auxiliary} {subject} {clause}/
                    /{auxiliary} {subject} {clause}/
        insert sign under node(language, @evo:en-standard:0) at end:
            sign EnglishPossessiveNP:
                belongs EnglishConstruction
                belongs PossessionConstruction
                belongs EnglishReferenceFrame
                phon:
                    /{possessor}s {possessed}/
        insert sign under node(language, @evo:en-standard:0) at end:
            sign EnglishPrepositionalPhrase:
                belongs EnglishConstruction
                belongs PrepositionalPhrase
                belongs EnglishRelationFrame
        insert sign under node(language, @evo:en-standard:0) at end:
            sign EnglishSVOTransitiveClause:
                belongs EnglishConstruction
                belongs SVOTransitiveClause
                belongs EnglishClauseFrame
                belongs AgreementBearer
                syn:
                    slot_features:
                        subject.case = $slot.predicate.syn.subject_case
                        object.case = $slot.predicate.syn.object_case
                    feature:
                        finite_form = enum(base, third_singular)
                        agreement_number = enum(singular, plural)
                        subject_case = enum(nominative, accusative)
                        object_case = enum(nominative, accusative)
                        number => $slot.subject.syn.number @stage word
                        person => $slot.subject.syn.person @stage word
                        agreement_number => $slot.subject.syn.number @stage word
                        subject_case => require($slot.subject.syn.case, $slot.predicate.syn.subject_case) @stage word
                        object_case => require($slot.object.syn.case, $slot.predicate.syn.object_case) @stage word
                        finite_form => third_singular / $slot.subject == [EnglishThirdSingular] @stage word
                            else finite_form => base
                phon:
                    realization:
                        case:
                            $self.syn.finite_form == third_singular:
                                /{subject} {predicate}s {object}/
                            else:
                                /{subject} {predicate} {object}/
                    /{subject} {predicate} {object}/
                prag:
                    clause-type = declarative
        insert sign under node(language, @evo:en-standard:0) at end:
            sign a:
                belongs EnglishDeterminer
                belongs EnglishIdentifiability
                phon:
                    /a/
                sem:
                    feature:
                        identifiability = indefinite
        insert sign under node(language, @evo:en-standard:0) at end:
            sign be:
                belongs EnglishCopula
                belongs EnglishCopulaFrame
                phon:
                    /be/
        insert sign under node(language, @evo:en-standard:0) at end:
            sign big:
