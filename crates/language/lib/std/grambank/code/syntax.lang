/* Grambank v1.0 functional subset: 25 language-level grammatical features.

   Each parameter has three explicit coding/knowledge states:
   - the named root trait carries `?` (not known),
   - `GBxxx_Absent` carries official code `0`,
   - `GBxxx_Present` carries official code `1`.

   `?` is not a third grammatical behavior.  Absence of a trait is therefore
   not silently interpreted as code 0.  The
   value traits also project a compact behavioral description into the
   appropriate syn/sem/prag dimensions.  They deliberately contain no Rule,
   Slot, or SlotMap: language-specific constructions may use the value trait
   as a rule guard without treating a typological observation as a universal
   executable grammar. */

trait GrambankSyntaxFeature:
    syn:
        typology.dataset = grambank-v1.0

/* Nominal determination: GB020. */
trait GB020_DefiniteOrSpecificArticles:
    belongs GrambankSyntaxFeature
    syn:
        typology.grambank.GB020 = ?
trait GB020_Absent:
    belongs GB020_DefiniteOrSpecificArticles
    syn:
        typology.grambank.GB020 = 0
        determination.definite-article = unavailable
    sem:
        reference.identifiability = not-article-marked
trait GB020_Present:
    belongs GB020_DefiniteOrSpecificArticles
    syn:
        typology.grambank.GB020 = 1
        determination.definite-article = available
    sem:
        reference.identifiability = article-marked

