/* Core ontology package (stdlib).  This is the dimension-neutral category
   tree used by `belongs`; category membership—not a mutable `syn.class`—is
   be overridden locally.  Keep executable declarations in code/, lookup
   metadata in data/, and package policy in config/ (architecture repair 6). */

export marker trait Semantic:
export trait SemanticFrame:
    belongs Semantic
export trait EventFrame:
    belongs SemanticFrame
export trait Entity:
    belongs Semantic
export trait Relation:
    belongs Semantic

/* P75:`number` 帶 `?` —— agreement number 依定義是**由脈絡供給**的
   (DerivationContext 注入,或外層構式經 slot_features 設定),詞條自己不一定有。
   `person` 不標:實測沒有任何讀取路徑會在它缺席時觸發,不無憑據放寬。 */
export trait AgreementBearer:
    syn:
        feature:
            number = enum(singular, plural)?
            person = enum(first, second, third)

export marker trait Predicate:
export trait Copula:
    belongs Predicate
export trait Verb:
    belongs Predicate
    belongs Event
export trait Intransitive:
    belongs Verb
export trait Transitive:
    belongs Verb
export trait Ditransitive:
    belongs Transitive

/* 語法化階梯(P14 Life Cycle 軸)的兩級。`reanalyze{target: category}` 搬動的是
   `belongs`,故階梯上的每一級都必須是本體樹裡真存在的範疇——否則「重新分析成
   助動詞」寫不出目標。Aux 仍是謂語性的;Bound 已是附著形式,不再獨立作謂語,
   故不 belongs Predicate。 */
export trait Aux:
    belongs Predicate
export marker trait Bound:

/* 名詞性 → 語意實體。P71-S:這類推論是**語言學分析**,故住套件而非引擎;
   換一個 std 就換一套推論(此前硬寫在 `sem.rs` 的 bridge)。 */
export trait Nominal:
    belongs AgreementBearer
    AgreementBearer[0]
    belongs Entity
export trait Noun:
    belongs Nominal
export trait Pronoun:
    belongs Nominal
export marker trait Adposition:
export trait Locative:
    belongs Adposition

export trait Physical:
    belongs Entity
export trait Animate:
    belongs Physical
export trait Human:
    belongs Animate
export trait Event:
    belongs EventFrame
export trait Motion:
    belongs Event
export trait TransferFrame:
    belongs EventFrame
    sem:
        roles:
            agent [Animate]
            theme [Entity]
            recipient [Animate]?
export trait Transfer:
    belongs TransferFrame
    TransferFrame[0]

export marker trait Pragmatic:
export trait Illocution:
    belongs Pragmatic
export trait SocialDeixis:
    belongs Pragmatic
export trait InfoStructure:
    belongs Pragmatic
export trait Stance:
    belongs Pragmatic
export trait Deixis:
    belongs Pragmatic
