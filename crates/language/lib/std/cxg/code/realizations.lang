/* Optional concrete realization patterns for the abstract schemas in
   schema.lang. These are ordinary traits, not `recipe`/`goal` declarations:
   recipe and goal are diachronic function-layer names, not synchronic .lang
   keywords. A natural-language package may inherit one of these patterns or
   provide a different realization. */

trait PrepositionalPhrase:
    belongs AdpositionConstruction
    phon:
        /{$slot.marker} {$slot.complement}/
    syn:
        feature:
            order = enum(marker_complement)
            order = marker_complement
    constraints:
        before($slot.marker, $slot.complement)
        adjacent($slot.marker, $slot.complement)

trait PostpositionalPhrase:
    belongs AdpositionConstruction
    phon:
        /{$slot.complement} {$slot.marker}/
    syn:
        feature:
            order = enum(complement_marker)
            order = complement_marker
    constraints:
        before($slot.complement, $slot.marker)
        adjacent($slot.complement, $slot.marker)

trait SVOTransitiveClause:
    belongs TransitiveClauseConstruction
    phon:
        /{$slot.subject} {$slot.predicate} {$slot.object}/
    syn:
        feature:
            order = enum(subject_predicate_object)
            order = subject_predicate_object
    constraints:
        before($slot.subject, $slot.predicate)
        before($slot.predicate, $slot.object)
        adjacent($slot.subject, $slot.predicate)
        adjacent($slot.predicate, $slot.object)

trait OVSTransitiveClause:
    belongs TransitiveClauseConstruction
    phon:
        /{$slot.object} {$slot.predicate} {$slot.subject}/
    syn:
        feature:
            order = enum(object_predicate_subject)
            order = object_predicate_subject
    constraints:
        before($slot.object, $slot.predicate)
        before($slot.predicate, $slot.subject)
        adjacent($slot.object, $slot.predicate)
        adjacent($slot.predicate, $slot.subject)

trait PrefixNegation:
    belongs NegationConstruction
    syn:
        slots:
            negator [*]
    phon:
        /{$slot.negator}{$slot.predicate}/
    constraints:
        before($slot.negator, $slot.predicate)
        adjacent($slot.negator, $slot.predicate)

trait SuffixNegation:
    belongs NegationConstruction
    syn:
        slots:
            negator [*]
    phon:
        /{$slot.predicate}{$slot.negator}/
    constraints:
        before($slot.predicate, $slot.negator)
        adjacent($slot.predicate, $slot.negator)

trait InitialPolarQuestion:
    belongs PolarQuestionConstruction
    syn:
        slots:
            particle [*]
    phon:
        /{$slot.particle} {$slot.clause}/
    constraints:
        before($slot.particle, $slot.clause)
        adjacent($slot.particle, $slot.clause)

trait SerialPredicate:
    belongs SerialPredicateConstruction
    phon:
        /{$slot.first} {$slot.second}/
    constraints:
        before($slot.first, $slot.second)
        adjacent($slot.first, $slot.second)
