
/* Contemporary formal Standard English common to British and American usage.
   Spaces in phon templates are structural word boundaries and are rendered
   automatically by `surface_phrase`; capitalization and punctuation remain
   outside this phon fixture. Semantic identity is trait membership plus provenance, never a free `sem.frame`,
   `sem.gloss`, or `sem.concept` string.

   `dog/dogs` is represented by one deep construction sign below.  The
   surface branch is selected after the token's declared number feature has
   been constrained; it is not a second `dogs` sign.  `seen` remains an
   explicitly lexicalized irregular participle workaround. */

Symbol a
Symbol b
Symbol d
Symbol e
Symbol g
Symbol h
Symbol i
Symbol j
Symbol k
Symbol m
Symbol n
Symbol o
Symbol r
Symbol s
Symbol t
Symbol u
Symbol y

Class vowel {a, e, i, o, u, y}

export trait StandardEnglishProfile:
    belongs GB020_Present
    belongs GB021_Present
    belongs GB028_Absent
    belongs GB030_Present
    belongs GB044_Present
    belongs GB057_Absent
    belongs GB059_Absent
    belongs GB068_Absent
    belongs GB070_Absent
    belongs GB074_Present
    belongs GB075_Absent
    belongs GB082_Absent
    belongs GB083_Present
    belongs GB084_Absent
    belongs GB086_Absent
    belongs GB103_Absent
    belongs GB107_Present
    belongs GB117_Present
    belongs GB118_Present
    belongs GB132_Present
    belongs GB147_Absent
    belongs GB155_Absent
    belongs GB262_Absent
    belongs GB322_Absent
    belongs GB522_Absent

export trait EnglishConstruction:
    belongs StandardEnglishProfile
    belongs FormMeaningConstruction

/* Natural-language-specific semantic and feature schemas.  AgreementBearer
   comes from std:core; its domains are deliberately inherited rather than
   recreated as unconstrained syn paths. */
export trait EnglishCountMeaning:
    sem:
        feature:
            number = enum(singular, plural)

export trait EnglishIdentifiability:
    belongs Semantic
    sem:
        feature:
            identifiability = enum(definite, indefinite)

export trait EnglishVoiceBearer:
    syn:
        feature:
            voice = enum(active, passive)

export trait EnglishThirdSingular:
    belongs AgreementBearer
    syn:
        feature:
            number = singular
            person = third

/* Case is a property of a nominal occurrence, while government lives on the
   predicate that licenses that occurrence.  A clause copies the predicate's
   requirement into a per-slot occurrence context; the lexical sign remains
   immutable and the nominal selects its own surface realization. */
export trait EnglishCaseBearer:
    belongs Nominal
    syn:
        feature:
            case = enum(nominative, accusative)

export trait EnglishSubjectCaseAssigner:
    belongs Predicate
    syn:
        feature:
            subject_case = enum(nominative, accusative)

export trait EnglishNominativeSubjectCaseAssigner:
    belongs EnglishSubjectCaseAssigner
    syn:
        feature:
            subject_case = nominative

export trait EnglishObjectCaseAssigner:
    belongs Predicate
    syn:
        feature:
            object_case = enum(nominative, accusative)

export trait EnglishFiniteTransitiveCaseAssigner:
    belongs EnglishNominativeSubjectCaseAssigner
    belongs EnglishObjectCaseAssigner
    syn:
        feature:
            object_case = accusative

export trait EnglishFiniteIntransitivePredicate:
    belongs Intransitive
    belongs EnglishNominativeSubjectCaseAssigner

export trait EnglishFiniteTransitivePredicate:
    belongs Transitive
    belongs EnglishFiniteTransitiveCaseAssigner

export trait EnglishDeterminer:
    belongs Semantic
export trait EnglishAdjective:
    belongs Semantic
export trait EnglishAuxiliary:
    belongs Predicate
    belongs AgreementBearer
export trait EnglishCopula:
    belongs EnglishAuxiliary
    belongs Copula
export trait EnglishNegator:
    belongs Semantic
export trait EnglishPluralMarker:
    belongs Semantic

/* Semantic frame identity is ontology membership.  These traits distinguish
   frame/function classes without introducing a mutable `frame = string`. */
export trait EnglishReferenceFrame:
    belongs SemanticFrame
export trait EnglishRelationFrame:
    belongs SemanticFrame
export trait EnglishClauseFrame:
    belongs EventFrame
export trait EnglishCopularFrame:
    belongs EventFrame
export trait EnglishNegationFrame:
    belongs EventFrame
export trait EnglishQuestionFrame:
    belongs EventFrame
export trait EnglishPassiveFrame:
    belongs EventFrame
export trait EnglishCountNounFrame:
    belongs SemanticFrame
export trait EnglishRunFrame:
    belongs EventFrame
export trait EnglishSeeFrame:
    belongs EventFrame
export trait EnglishCopulaFrame:
    belongs EventFrame
export trait EnglishDoSupportFrame:
    belongs EventFrame
export trait EnglishDogConcept:
    belongs Entity
export trait EnglishThirdFemininePerson:
    belongs Human
export trait EnglishBookConcept:
    belongs Entity
export trait EnglishHouseConcept:
    belongs Entity
export trait EnglishBigProperty:
    belongs Semantic
export trait EnglishInRelation:
    belongs Relation

/* Horizontal allomorph links.  Clause constructions derive `finite_form`
   first; deferred autofill then selects a stored member Sign. */
export paradigm EnglishBE:
    case [syn.finite_form]:
        [third_singular]: is()
        base: be()

export paradigm EnglishDO:
    case [syn.finite_form]:
        [third_singular]: does()
        base: do()

export sign john:
    belongs Noun
    belongs EnglishCaseBearer
    belongs Human
    belongs EnglishThirdSingular
    phon:
        /john/

export sign mary:
    belongs Noun
    belongs EnglishCaseBearer
    belongs Human
    belongs EnglishThirdSingular
    phon:
        /mary/

/* One lexical sign realizes two surface case forms.  Case is supplied by its
   clause occurrence, never stored back into this source sign. */
export sign she:
    belongs Pronoun
    belongs EnglishCaseBearer
    belongs EnglishThirdSingular
    belongs EnglishThirdFemininePerson
    phon:
        /she/
        realization:
            case:
                $self.syn.case == nominative:
                    /she/
                $self.syn.case == accusative:
                    /her/

/* `dog` is a lexical stem.  Singular/plural surface realization belongs to
   EnglishCountNounForm, whose SignId stays stable across contexts. */
export sign dog:
    belongs Noun
    belongs EnglishCaseBearer
    belongs EnglishDogConcept
    belongs EnglishThirdSingular
    phon:
        /dog/

export sign book:
    belongs Noun
    belongs EnglishCaseBearer
    belongs EnglishBookConcept
    belongs EnglishThirdSingular
    phon:
        /book/

export sign house:
    belongs Noun
    belongs EnglishCaseBearer
    belongs EnglishHouseConcept
    belongs EnglishThirdSingular
    phon:
        /house/

export sign the:
    belongs EnglishDeterminer
    belongs EnglishIdentifiability
    sem:
        feature:
            identifiability = definite
    phon:
        /the/

export sign a:
    belongs EnglishDeterminer
    belongs EnglishIdentifiability
    sem:
        feature:
            identifiability = indefinite
    phon:
        /a/

export sign big:
    belongs EnglishAdjective
    belongs EnglishBigProperty
    phon:
        /big/

export sign in:
    belongs Adposition
    belongs EnglishInRelation
    phon:
        /in/

export sign plural_s:
    belongs EnglishPluralMarker
    belongs EnglishCountMeaning
    sem:
        feature:
            number = plural
    phon:
        /s/

/* These are deep lexical bases.  Their finite spell-outs are selected by the
   containing finite-clause constructions, rather than by sibling runs/sees
   signs. */
export sign run:
    belongs EnglishFiniteIntransitivePredicate
    belongs EnglishRunFrame
    phon:
        /run/

export sign see:
    belongs EnglishFiniteTransitivePredicate
    belongs EnglishSeeFrame
    phon:
        /see/

export sign be:
    belongs EnglishCopula
    belongs EnglishCopulaFrame
    syn:
        feature:
            finite_form = enum(base, third_singular)
            finite_form = base
    phon:
        /be/

export sign do:
    belongs EnglishAuxiliary
    belongs EnglishDoSupportFrame
    syn:
        feature:
            finite_form = enum(base, third_singular)
            finite_form = base
    phon:
        /do/

export sign does:
    belongs EnglishAuxiliary
    belongs EnglishDoSupportFrame
    syn:
        feature:
            finite_form = enum(base, third_singular)
            finite_form = third_singular
    phon:
        /does/

export sign is:
    belongs EnglishCopula
    belongs EnglishCopulaFrame
    syn:
        feature:
            finite_form = enum(base, third_singular)
            finite_form = third_singular
    phon:
        /is/

export sign not:
    belongs EnglishNegator
    phon:
        /not/

/* An irregular lexicalized participle: deliberately retained as a
   workaround, not evidence for productive regular morphology. */
export sign seen:
    belongs Transitive
    belongs EnglishSeeFrame
    belongs EnglishVoiceBearer
    lexicalized = true
    syn:
        feature:
            voice = passive
    phon:
        /seen/

export sign EnglishDefiniteNP:
    belongs EnglishConstruction
    belongs DeterminationConstruction
    belongs EnglishReferenceFrame
    syn:
        feature:
            determination = enum(definite, indefinite)
            determination = definite
    prag:
        identifiability = identifiable
    phon:
        /{$slot.determiner} {$slot.nominal}/

export sign EnglishIndefiniteNP:
    belongs EnglishConstruction
    belongs DeterminationConstruction
    belongs EnglishReferenceFrame
    syn:
        feature:
            determination = enum(definite, indefinite)
            determination = indefinite
    prag:
        identifiability = non-identifiable
    phon:
        /{$slot.determiner} {$slot.nominal}/

/* One deep noun-form construction.  A DerivationContext supplies its number
   constraint; the sem feature reads finalized syn state through read-only
   $self, then realization chooses a complete phon template. */
export sign EnglishCountNounForm:
    belongs EnglishConstruction
    belongs EnglishCountMeaning
    belongs EnglishCountNounFrame
    belongs AgreementBearer
    syn:
        slots:
            stem [Noun]
    sem:
        feature:
            number => $self.syn.number
        roles:
            referent [Entity]
            referent = {$slot.stem}
    phon:
        /{$slot.stem}/
        realization:
            case:
                $self.syn.number == plural:
                    /{$slot.stem}s/
                base:
                    /{$slot.stem}/

export sign EnglishPluralNP:
    belongs EnglishConstruction
    belongs NumberMarkingConstruction
    belongs EnglishCountMeaning
    belongs EnglishReferenceFrame
    belongs AgreementBearer
    syn:
        feature:
            number = plural
    sem:
        feature:
            number = plural
    phon:
        /{$slot.nominal}{$slot.marker}/

export sign EnglishPossessiveNP:
    belongs EnglishConstruction
    belongs PossessionConstruction
    belongs EnglishReferenceFrame
    phon:
        /{$slot.possessor}s {$slot.possessed}/

export sign EnglishAttributiveNP:
    belongs EnglishConstruction
    belongs AttributionConstruction
    belongs EnglishReferenceFrame
    syn:
        feature:
            order = enum(attribute_nominal)
            order = attribute_nominal
    phon:
        /{$slot.attribute} {$slot.nominal}/

export sign EnglishPrepositionalPhrase:
    belongs EnglishConstruction
    belongs PrepositionalPhrase
    belongs EnglishRelationFrame

export sign EnglishIntransitiveClause:
    belongs EnglishConstruction
    belongs IntransitiveClauseConstruction
    belongs EnglishClauseFrame
    belongs AgreementBearer
    syn:
        slot_features:
            subject.case = $slot.predicate.syn.subject_case
        feature:
            finite_form = enum(base, third_singular)
            agreement_number = enum(singular, plural)
            subject_case = enum(nominative, accusative)
            number => $slot.subject.syn.number
            person => $slot.subject.syn.person
            agreement_number => $slot.subject.syn.number
            subject_case => require($slot.subject.syn.case, $slot.predicate.syn.subject_case)
            finite_form => third_singular / $slot.subject == [EnglishThirdSingular]
            else finite_form => base
    prag:
        clause-type = declarative
    phon:
        /{$slot.subject} {$slot.predicate}/
        realization:
            case:
                $self.syn.finite_form == third_singular:
                    /{$slot.subject} {$slot.predicate}s/
                base:
                    /{$slot.subject} {$slot.predicate}/

export sign EnglishSVOTransitiveClause:
    belongs EnglishConstruction
    belongs SVOTransitiveClause
    belongs EnglishClauseFrame
    belongs AgreementBearer
    syn:
        slot_features:
            subject.case = $slot.predicate.syn.subject_case
            object.case = $slot.predicate.syn.object_case
        feature:
            finite_form = enum(base, third_singular)
            agreement_number = enum(singular, plural)
            subject_case = enum(nominative, accusative)
            object_case = enum(nominative, accusative)
            number => $slot.subject.syn.number
            person => $slot.subject.syn.person
            agreement_number => $slot.subject.syn.number
            subject_case => require($slot.subject.syn.case, $slot.predicate.syn.subject_case)
            object_case => require($slot.object.syn.case, $slot.predicate.syn.object_case)
            finite_form => third_singular / $slot.subject == [EnglishThirdSingular]
            else finite_form => base
    prag:
        clause-type = declarative
    phon:
        /{$slot.subject} {$slot.predicate} {$slot.object}/
        realization:
            case:
                $self.syn.finite_form == third_singular:
                    /{$slot.subject} {$slot.predicate}s {$slot.object}/
                base:
                    /{$slot.subject} {$slot.predicate} {$slot.object}/

export sign EnglishCopularPredication:
    belongs EnglishConstruction
    belongs CopularPredicationConstruction
    belongs EnglishCopularFrame
    belongs AgreementBearer
    syn:
        map copula autofill EnglishBE()
        feature:
            finite_form = enum(base, third_singular)
            number => $slot.subject.syn.number
            person => $slot.subject.syn.person
            finite_form => third_singular / $slot.subject == [EnglishThirdSingular]
            else finite_form => base
    prag:
        clause-type = declarative
    phon:
        /{$slot.subject} {$slot.copula} {$slot.predicate}/

export sign EnglishDoNegation:
    belongs EnglishConstruction
    belongs NegationConstruction
    belongs EnglishNegationFrame
    belongs AgreementBearer
    syn:
        slots:
            subject [Nominal]
            auxiliary [EnglishAuxiliary]
            negator [EnglishNegator]
        map auxiliary autofill EnglishDO()
        feature:
            finite_form = enum(base, third_singular)
            number => $slot.subject.syn.number
            person => $slot.subject.syn.person
            finite_form => third_singular / $slot.subject == [EnglishThirdSingular]
            else finite_form => base
    prag:
        clause-type = declarative
    phon:
        /{$slot.subject} {$slot.auxiliary} {$slot.negator} {$slot.predicate}/

export sign EnglishPolarQuestion:
    belongs EnglishConstruction
    belongs PolarQuestionConstruction
    belongs EnglishQuestionFrame
    belongs AgreementBearer
    syn:
        slots:
            auxiliary [EnglishAuxiliary]
            subject [Nominal]
        map auxiliary autofill EnglishDO()
        feature:
            finite_form = enum(base, third_singular)
            number => $slot.subject.syn.number
            person => $slot.subject.syn.person
            finite_form => third_singular / $slot.subject == [EnglishThirdSingular]
            else finite_form => base
    phon:
        /{$slot.auxiliary} {$slot.subject} {$slot.clause}/

export sign EnglishPeriphrasticPassive:
    belongs EnglishConstruction
    belongs PassiveConstruction
    belongs EnglishPassiveFrame
    belongs AgreementBearer
    syn:
        map auxiliary autofill EnglishBE()
        feature:
            finite_form = enum(base, third_singular)
            number => $slot.patient.syn.number
            person => $slot.patient.syn.person
            finite_form => third_singular / $slot.patient == [EnglishThirdSingular]
            else finite_form => base
    prag:
        perspective = patient-prominent
    phon:
        /{$slot.patient} {$slot.auxiliary} {$slot.predicate} by {$slot.agent}/
