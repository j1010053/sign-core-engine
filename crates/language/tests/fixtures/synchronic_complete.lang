/* 共時 `.lang` 完整表面 fixture。
   construction type 與共時狀態在此；歷史 attestation/evidence 不在 Language。
   P71 §4.3 + A3:`senses[key].*` 與裸 sem/syn Def 一律改走 `feature:` / `roles:`。 */

Symbol a
Symbol d

trait CommonNoun:
    belongs Noun
trait Determiner:

sign article:
    belongs Determiner
    phon:
        /a/
    sem:
        feature:
            concept = enum(DEFINITE, DOG, DEFINITE_NP)
            concept = DEFINITE

sign dog:
    belongs CommonNoun
    phon:
        /d/
    sem:
        senses:
            core = dog
        feature:
            concept = enum(DEFINITE, DOG, DEFINITE_NP)
            concept = DOG

sign proto_np:
    belongs CommonNoun
    phon:
        /d/

sign NP:
    belongs CommonNoun
    origin = sign(proto_np)
    provenance = grammaticalized
    lifecycle = active
    entrenchment = 0.75
    lexicalized = true
    syn:
        slots:
            det [Determiner]?
            head [CommonNoun]
            tail [CommonNoun]?
        map det autofill article
        map det internalize
        map head rename nucleus
        map head optional false
        map tail preserve
        feature:
            licensing_register = enum(general)
            licensing_register = general
    phon:
        /{det}{head}{tail}/
    sem:
        roles:
            profile [*]
            profile = {head}
        feature:
            concept = enum(DEFINITE, DOG, DEFINITE_NP)
            concept = DEFINITE_NP
