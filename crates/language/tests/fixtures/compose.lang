/* 步驟 12 fixture:詞根+詞綴組合 → 循環 → 表層(surface sandhi 首測)。
   規則語意錨定上游 tshiatun dsl/tests/stages.rs 的已驗證模式。 */

Feature Type(*cons, vowel)
Feature voice(+voice, -voice)

Symbol a [vowel]
Symbol p [cons -voice]
Symbol b [cons +voice]
Symbol x [cons -voice]

Class vowel {a}

Melody tone {H} anchor mora

global trait Phonology {
    p a => b a @stage stem
    a => x / _ + a @stage word
    p => b / _ ## b @stage phrase
}

sign root_pa {
    phon = /pa/
}

sign root_ap {
    phon = /ap/
}

sign suffix_ap {
    phon = /ap/
}

sign clitic_x {
    phon = /ap/
    a => x / # _ @stage stem
}

sign clitic_tonal {
    phon = /pa/
    insert H floating near mora / onset&[-voice] _ @stage stem
}

sign clitic_word_rule {
    phon = /ap/
    a => x / _ # @stage word
}

sign no_ur {
    entrenchment = 0.5
}

sign bad_ur {
    phon = pa
}
