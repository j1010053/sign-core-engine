/* 共時語法系統整合(12a–12e 總檢查):
   單一分類樹 + 四維投影 + construction(form-meaning)+ 同步規則(Else)+ patch + entrenchment。*/

Symbol r
Symbol u
Symbol n
Symbol d
Symbol o
Symbol g

Class vowel {u, o}

trait Honorific:
trait VerbStatus:
    syn:
        feature:
            valence = enum(base, intransitive)
            valence = base

sign run:
    belongs Verb
    belongs Motion
    belongs VerbStatus
    entrenchment = 0.9
    syn:
        feature:
            valence => intransitive / [Verb]
    sem:
        senses:
            core = RUN
        feature:
            manner = enum(neutral, rapid)
            manner = neutral
    phon:
        /run/
sign dog:
    belongs Noun
    sem:
        senses:
            core = DOG
    phon:
        /dog/
sign lord:
    belongs Noun
    belongs Honorific
    sem:
        senses:
            core = LORD
    prag:
        feature:
            register = enum(formal, neutral)
            register => formal / [Honorific]
                else register => neutral
    phon:
        /god/

sign Clause:
    belongs Verb
    syn:
        slots:
            subject [Noun]
            predicate [Verb]
    sem:
        roles:
            actor [Semantic]
            action [Semantic]
            actor = {subject}
            action = {predicate}
        feature:
            frame = enum(event)
            frame = event
    phon:
        /{subject}{predicate}/
