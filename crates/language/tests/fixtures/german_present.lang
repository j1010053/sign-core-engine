/* 德語現在式變位系統 — 步驟 12b 驗收(construction + slots)。
   正字形音段(sag- 詞幹 + 人稱後綴);分離前綴 auf- 為 optional slot(?);
   過去分詞 ge-…-t 環綴以模板字面素材表達。分類節點擴充 stdlib。 */

Symbol s
Symbol a
Symbol g
Symbol e
Symbol t
Symbol n
Symbol u
Symbol f

Class vowel {a, e, u}

trait VerbStem:
    belongs Verb
trait Suffix:
trait AgrSuffix:
    belongs Suffix
trait Prefix:

sign sag:
    belongs VerbStem
    phon:
        /sag/
sign suffix_1sg:
    belongs AgrSuffix
    phon:
        /e/
sign suffix_2sg:
    belongs AgrSuffix
    phon:
        /st/
sign suffix_3sg:
    belongs AgrSuffix
    phon:
        /t/
sign suffix_1pl:
    belongs AgrSuffix
    phon:
        /en/
sign suffix_2pl:
    belongs AgrSuffix
    phon:
        /t/
sign suffix_3pl:
    belongs AgrSuffix
    phon:
        /en/
sign auf:
    belongs Prefix
    phon:
        /auf/

sign PresentVerb:
    belongs Verb
    syn:
        slots:
            prefix [Prefix]?
            stem [VerbStem]
            suffix [AgrSuffix]
    phon:
        /{$slot.prefix}{$slot.stem}{$slot.suffix}/
sign Participle:
    belongs Verb
    syn:
        slots:
            stem [VerbStem]
    phon:
        /ge{$slot.stem}t/
