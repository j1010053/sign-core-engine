---
source: crates/language/tests/compile_passes.rs
expression: dump
---
Feature voice(+voice, -voice)
Prosody mora < syllable < foot < pword < phrase < iphrase < utterance

global trait CorePhonology:
    phon:
        a => ə / _# @stage word
        n => m / _# @stage stem

trait VerbCommon:
    syn:
        provides = VERB
    ==
    entrenchment = 0.5

sign go:
    entrenchment = 0.8
    syn:
        provides = VERB.motion
    phon:
        /go/
        g => k / #_ @stage stem
        o => ə / _# @stage phrase
