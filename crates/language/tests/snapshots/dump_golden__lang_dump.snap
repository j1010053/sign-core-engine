---
source: crates/language/tests/dump_golden.rs
expression: dump
---
Feature voice(+voice, -voice)
Feature sonorant(+sonorant)
Symbol m [+sonorant]
Class vowel {a, e, i, o, u}

prosody = μ σ Ft ω φ ι U

distribution:
    /k/ = 0.15
    /t/ = 0.20

global trait CorePhonology:
    phon:
        a => ə / _# @stage word
    ==
    phon:
        n => m / _[+labial] @stage stem

trait VerbCommon:
    syn:
        provides = VERB
        requires = [agent, patient]
    ==
    phon:
        valence => 2 / _[+move] @stage word

sign go:
    VerbCommon[0]
    VerbCommon[1]
    entrenchment = 0.8
    phon:
        /go/
    sem:
        senses = [ sense s1 { concept = GO } ]
