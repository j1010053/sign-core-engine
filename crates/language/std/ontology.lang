/* 最小本體(stdlib)— 步驟 12a,I20:本體是資料層 .lang trait,額外引用併入。
   單一維度中立分類樹(P38 v0.2);belongs = 父邊。範疇預設(如 syn.class)由後代
   繼承、可覆蓋。使用者 .lang 可擴充自定範疇,掛回本體某節點(docs/07 §9)。 */

trait Predicate:
trait Verb:
    belongs Predicate
    syn:
        class = verb
trait Intransitive:
    belongs Verb
trait Transitive:
    belongs Verb
trait Ditransitive:
    belongs Transitive
trait Nominal:
    syn:
        class = nominal
trait Noun:
    belongs Nominal
trait Pronoun:
    belongs Nominal
trait Adposition:
trait Locative:
    belongs Adposition

trait Entity:
trait Physical:
    belongs Entity
trait Animate:
    belongs Physical
trait Human:
    belongs Animate
trait Event:
trait Motion:
    belongs Event
trait Transfer:
    belongs Event

trait Pragmatic:
trait Illocution:
    belongs Pragmatic
trait SocialDeixis:
    belongs Pragmatic
trait InfoStructure:
    belongs Pragmatic
trait Stance:
    belongs Pragmatic
trait Deixis:
    belongs Pragmatic
